# Copy this file to .env and fill in the key. .env is ignored by git.
# Get a key at https://app.timefold.ai under Settings > API keys.
TIMEFOLD_API_KEY=

# scripts/login.py (and setup.sh) fill these in when you sign in.
DATAVERSE_URL=
DATAVERSE_TENANT_ID=

# Optional: an Entra ID app registration, added to the environment as an
# application user, instead of your own sign-in.
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
