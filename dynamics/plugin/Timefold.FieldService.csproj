<Project Sdk="Microsoft.NET.Sdk">
  <!-- A Dataverse plug-in assembly. Dataverse runs plug-ins on .NET Framework
       4.6.2 in a sandbox, so: net462, no dependencies beyond the SDK, and a
       strong-name signature (Dataverse refuses unsigned assemblies). -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Timefold.FieldService</AssemblyName>
    <RootNamespace>Timefold.FieldService</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Timefold.FieldService.snk</AssemblyOriginatorKeyFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Dataverse provides these at run time. scripts/build_plugin.sh fetches
         them from the Microsoft.CrmSdk.CoreAssemblies package. -->
    <Reference Include="Microsoft.Xrm.Sdk"><HintPath>../../.tools/sdk/Microsoft.Xrm.Sdk.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Crm.Sdk.Proxy"><HintPath>../../.tools/sdk/Microsoft.Crm.Sdk.Proxy.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
  </ItemGroup>
</Project>
